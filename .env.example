# Copy to .env and fill in. Never commit .env.

# Closed LLMs
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_DIRECT_BASE_URL=
GOOGLE_API_KEY=
GOOGLE_BASE_URL=
XAI_API_KEY=

# Open-weight hosts
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
DASHSCOPE_API_KEY=
YUNWU_API_KEY=
YUNWU_BASE_URL=https://api.yunwu.ai/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional model proxy. Set WCA_MODEL_PROXY=gptplus5 to route supported
# closed_llm/open_llm/search_llm/deep_research_agent roster entries through
# GPTPlus5/New API instead of their configured provider. Keep the real key in
# .env, never in git.
WCA_MODEL_PROXY=
GPTPLUS5_API_KEY=
GPTPLUS5_BASE_URL=https://az.gptplus5.com/v1

# Search-enabled / agents
PERPLEXITY_API_KEY=
MIROMIND_API_KEY=

# Data ingest
API_FOOTBALL_KEY=
FOOTBALL_DATA_ORG_KEY=

# News ingest (optional; falls back to Google News RSS when both are empty)
NEWSAPI_KEY=
GNEWS_API_KEY=
